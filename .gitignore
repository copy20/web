# ============================================================
# web 项目忽略规则
# 本项目为「Python 标准库 HTTP 服务 + 原生静态页面」，
# 无 node_modules / 构建产物，运行时也不落盘数据文件。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 日志 ----------
*.log
logs/
nohup.out

# ---------- 本地配置与数据 ----------
.env
.env.*
!.env.example
data/
tmp/
temp/

# ---------- Visual Studio / VS Code / IDEA ----------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# ---------- 系统文件 ----------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# ---------- 备份与临时文件 ----------
*.bak
*.tmp
~$*
